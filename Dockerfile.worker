FROM python:3.10-slim

WORKDIR /app

# 安装系统依赖（textract需要）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    build-essential \
    antiword \
    unrtf \
    poppler-utils \
    pstotext \
    tesseract-ocr \
    flac \
    ffmpeg \
    lame \
    libmad0 \
    libsox-fmt-mp3 \
    sox \
    libjpeg-dev \
    swig \
    libpulse-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 复制FastDatasets源码
COPY fastdatasets/ ./fastdatasets/
COPY requirements.txt .
COPY setup.py .
COPY pyproject.toml .

# 安装FastDatasets
RUN pip install --no-cache-dir -e .

# 复制命令构建脚本和entrypoint
COPY cmd_builder.py /app/cmd_builder.py
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 创建数据目录
RUN mkdir -p /workspace/user-data/dataset

# 入口点
ENTRYPOINT ["/app/entrypoint.sh"]
